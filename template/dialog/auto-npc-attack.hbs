<div class="dark-heresy dialog">
    <div class="flex column background border" style="gap: 8px;">
        <h1>Auto Attacks: {{actorName}}</h1>
        <div class="wrapper">
            <label>Target</label>
            <select id="auto-npc-target">
                {{#each targets}}
                    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="wrapper">
            <label>Charge Range</label>
            <input type="text" value="{{chargeRange}} {{units}}" disabled />
        </div>
        <div class="separator"></div>
        <div class="wrapper">
            <label>Ranged Weapon</label>
            <select id="auto-npc-ranged-weapon">
                {{#each rangedWeapons}}
                    <option value="{{id}}">{{label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="wrapper">
            <label>Melee Weapon</label>
            <select id="auto-npc-melee-weapon">
                {{#each meleeWeapons}}
                    <option value="{{id}}">{{label}}</option>
                {{/each}}
            </select>
        </div>
        <p style="margin: 0;">
            <em>Fate rerolls are available from the chat card after the roll.</em>
        </p>
    </div>
</div>
